//@version=5
strategy("Buy the Dips (50 EMA)", overlay=true,
  initial_capital=25000, default_qty_type=strategy.fixed, default_qty_value=1,
  commission_type=strategy.commission.cash_per_contract, commission_value=5.50,
  slippage=1, pyramiding=0, process_orders_on_close=true, calc_on_every_tick=false,
  max_bars_back=5000, max_labels_count=500)

// ===== EMA (50 EMA Turning Up) =====
show_ema             = input.bool(true, "Show 50 EMA", group="Visual")
ema_len              = input.int(50, "EMA Length", minval=5, group="Visual")
ema_slope_len        = input.int(2, "EMA Slope Lookback (bars)", minval=1, group="EMA Slope", tooltip="Bars used to calculate current slope.")
past_slope_offset    = input.int(10, "Past Slope Search Window", minval=1, group="EMA Slope", tooltip="Looks back this many bars to ensure the slope was previously negative.")
atr_len_slope        = input.int(14, "ATR length (for ° scale)", minval=1, group="EMA Slope")

// ===== GEOMETRIC DIP FILTER =====
use_geom_filter = input.bool(true, "Require Line to Left doesn't hit EMA", group="Geometric Dip", tooltip="Ensures a horizontal line drawn left from the dip's low does NOT intersect the 50 EMA.")
geom_lookback   = input.int(50, "Line Lookback (bars)", minval=10, group="Geometric Dip")

// ===== VOLUME PROFILE =====
profile_lookback = input.int(120, "Profile Lookback (bars)", minval=20, maxval=2000, step=10, group="Volume Profile")
profile_rows     = input.int(10, "Price Levels (rows)", minval=5, maxval=100, step=5, group="Volume Profile")

// ===== PIVOT PROGRESSION =====
use_pivot_filter = input.bool(true, "Require Higher Lows", group="Pivot", tooltip="Long: last N swing lows must be higher lows.")
pivot_left       = input.int(15, "Pivot Left Bars", minval=2, maxval=20, group="Pivot")
pivot_right      = input.int(7, "Pivot Right Bar", minval=2, maxval=20, group="Pivot")
pivot_count      = input.int(2, "Consecutive Pivots Required", minval=2, maxval=10, group="Pivot", tooltip="How many successive higher-lows must be present.")

// ===== OPPOSING POC S/R =====
use_opposing_poc   = input.bool(false, "Block opposing POC S/R", group="Opposing POC")
prior_poc_bars     = input.int(60, "Prior POC offset (bars)", minval=10, maxval=500, step=10, group="Opposing POC")
opposing_atr_mult  = input.float(2.0, "Block within ATR ×", minval=0.5, maxval=10.0, step=0.25, group="Opposing POC")

// ===== ENTRY =====
cooldown_bars   = input.int(10, "Cooldown (bars after exit)", minval=1, group="Entry")
poc_entry_pct   = input.float(0.0, "POC Entry Depth (%)", minval=0, maxval=100, step=5, group="Entry")

// ===== SESSION =====
use_session   = input.bool(true, "Use Session Filter")
sess_start_hr = input.int(18, "Session Start Hour (ET)")
sess_start_mn = input.int(0,  "Session Start Minute")
sess_end_hr   = input.int(16, "Session End Hour (ET)")
sess_end_mn   = input.int(45,  "Session End Minute")

// ===== RISK (PER CONTRACT) =====
pv             = input.float(50.0, "Point Value ($)", group="Risk")
use_poc_stop   = input.bool(false, "Use POC Boundary as Stop", group="Risk")
use_atr_risk   = input.bool(false, "ATR risk + runner trail", group="Risk")

// --- ATR risk (when use_atr_risk) ---
atr_risk_len              = input.int(14, "ATR length (risk)", minval=1, group="ATR Risk")
sl_atr_mult               = input.float(1.5, "Initial stop: ATR ×", minval=0.1, step=0.1, group="ATR Risk")
sl_atr_mult_reduced       = input.float(1.0, "Initial stop: ATR × (reduced window)", minval=0.1, step=0.1, group="ATR Risk")
tp_atr_mult               = input.float(4.0, "Limit TP: ATR × (0 = no cap, runner only)", minval=0, step=0.1, group="ATR Risk")
tp_atr_mult_reduced       = input.float(2.0, "Limit TP: ATR × (reduced)", minval=0, step=0.1, group="ATR Risk")
runner_activate_atr_mult  = input.float(0.25, "Arm trail after +profit (ATR ×)", minval=0, step=0.05, group="ATR Risk")
runner_trail_atr_mult     = input.float(1.0, "Runner trail: ATR × from peak", minval=0.1, step=0.1, group="ATR Risk")

// --- Legacy $ risk (when use_atr_risk off) ---
stop_dollars_per_contract   = input.float(500.0, "Stop per contract ($)", group="Risk $ (legacy)")
tp_dollars_per_contract     = input.float(1100.0, "Take Profit per contract ($)", group="Risk $ (legacy)")

// ===== REDUCED RISK (PER CONTRACT) =====
use_reduced_risk     = input.bool(false, "Use Reduced Risk Window", group="Reduced Risk")
reduced_start_hr     = input.int(18, "Start Hour (ET)", group="Reduced Risk")
reduced_start_mn     = input.int(0, "Start Minute", group="Reduced Risk")
reduced_end_hr       = input.int(8, "End Hour (ET)", group="Reduced Risk")
reduced_end_mn       = input.int(0, "End Minute", group="Reduced Risk")
reduced_stop_dollars_per_contract = input.float(300.0, "Reduced Stop per contract ($)", group="Reduced Risk")
reduced_tp_dollars_per_contract   = input.float(500.0, "Reduced TP per contract ($)", group="Reduced Risk")

// ===== BREAKEVEN (PER CONTRACT) =====
use_breakeven      = input.bool(false, "Breakeven after profit", group="Breakeven")
be_atr_mult        = input.float(0.5, "BE when profit ≥ ATR ×", minval=0.05, step=0.05, group="Breakeven")
be_trigger_dollars_per_contract = input.float(50.0, "BE trigger per contract ($) — legacy mode", minval=50, group="Breakeven")

// ===== TRAILING (PER CONTRACT - legacy $ mode only) =====
use_trail_stop    = input.bool(false, "Legacy $ trailing", group="Trailing")
trail_pct         = input.float(80.0, "Trail: Keep % of Peak", group="Trailing")
trail_step_amt_per_contract    = input.float(500.0, "Trail: Step every $X per contract", group="Trailing")
trail_step_pct    = input.float(10.0, "Trail: Tighten % per step", group="Trailing")
trail_min_dollars_per_contract = input.float(500.0, "Trail: Min Profit per contract ($)", group="Trailing")

// ===== COMPUTED DYNAMIC VALUES =====
qty = 1
stop_dollars        = stop_dollars_per_contract * qty
tp_dollars          = tp_dollars_per_contract * qty
reduced_stop_dollars= reduced_stop_dollars_per_contract * qty
reduced_tp_dollars  = reduced_tp_dollars_per_contract * qty
be_trigger_dollars  = be_trigger_dollars_per_contract * qty
trail_step_amt      = trail_step_amt_per_contract * qty
trail_min_dollars   = trail_min_dollars_per_contract * qty

float be_trigger_pts = be_trigger_dollars / (pv * qty)

// ===== SESSION LOGIC =====
bar_hr = hour(time, "America/New_York")
bar_mn = minute(time, "America/New_York")
bar_t  = bar_hr * 100 + bar_mn
int s_start = sess_start_hr * 100 + sess_start_mn
int s_end   = sess_end_hr * 100 + sess_end_mn
bool in_session = not use_session or (s_start > s_end ? (bar_t >= s_start or bar_t < s_end) : (bar_t >= s_start and bar_t < s_end))

int r_start = reduced_start_hr * 100 + reduced_start_mn
int r_end   = reduced_end_hr * 100 + reduced_end_mn
bool in_reduced = use_reduced_risk and (r_start > r_end ? (bar_t >= r_start or bar_t < r_end) : (bar_t >= r_start and bar_t < r_end))

float stop_pts = (in_reduced ? reduced_stop_dollars : stop_dollars) / (pv * qty)
float tp_pts   = (in_reduced ? reduced_tp_dollars   : tp_dollars)   / (pv * qty)

float sl_atr_m = in_reduced ? sl_atr_mult_reduced : sl_atr_mult
float tp_atr_m = in_reduced ? tp_atr_mult_reduced : tp_atr_mult

prev_hr = hour(time[1], "America/New_York")
prev_mn = minute(time[1], "America/New_York")
prev_t  = prev_hr * 100 + prev_mn
bool was_in = not use_session or (s_start > s_end ? (prev_t >= s_start or prev_t < s_end) : (prev_t >= s_start and prev_t < s_end))
if was_in and not in_session and strategy.position_size != 0
    strategy.close_all(comment="Session Close")

// ===== EMA + SLOPES =====
float ema_val = ta.ema(close, ema_len)
float ema_rise = ema_val - ema_val[ema_slope_len]
float atr_slope = ta.atr(atr_len_slope)
float atr_risk  = ta.atr(atr_risk_len)
bool  atr_ok    = not na(atr_risk) and atr_risk > 0
float ema_slope_deg = not na(atr_slope) and atr_slope > 0 ? math.atan(ema_rise / atr_slope) * 180.0 / math.pi : na

// Check that EMA was going down and is now going up
bool ema_is_positive = not na(ema_slope_deg) and ema_slope_deg > 0
bool ema_was_negative = false
if not na(ema_slope_deg)
    for i = 1 to past_slope_offset
        if nz(ema_slope_deg[i]) < 0
            ema_was_negative := true
            break

bool slope_ok_long = ema_is_positive and ema_was_negative

// ===== PIVOT PROGRESSION (higher lows) =====
float pl = ta.pivotlow(low,  pivot_left, pivot_right)
var array<float> recent_pl = array.new_float(0)
if not na(pl)
    recent_pl.push(pl)
    if recent_pl.size() > pivot_count
        recent_pl.shift()

bool has_higher_lows = recent_pl.size() >= pivot_count
if has_higher_lows
    for k = 1 to recent_pl.size() - 1
        if recent_pl.get(k) <= recent_pl.get(k - 1)
            has_higher_lows := false
            break
bool pivot_ok_long  = not use_pivot_filter or has_higher_lows

// ===== GEOMETRIC DIP FILTER (Line to the left) =====
// Draw an imaginary horizontal line backwards from the recent dip low.
// If it intersects the 50 EMA, the market is chopping and it's NOT a true dip.
float current_dip = recent_pl.size() > 0 ? recent_pl.get(recent_pl.size() - 1) : low
float highest_ema = ta.highest(ema_val, geom_lookback)
float lowest_ema  = ta.lowest(ema_val, geom_lookback)

// It intersects if the dip level is squeezed between the recent highs and lows of the EMA
bool line_intersects_ema = (current_dip <= highest_ema) and (current_dip >= lowest_ema)
bool geometric_dip_ok = not use_geom_filter or not line_intersects_ema

// ===== VOLUME PROFILE WITH DELTA =====
int lb   = math.min(profile_lookback, bar_index)
int rows = profile_rows

float prof_hi   = ta.highest(high, lb > 0 ? lb : 1)
float prof_lo   = ta.lowest(low, lb > 0 ? lb : 1)
float prof_span = prof_hi - prof_lo
float step_size = prof_span > 0 ? prof_span / rows : na

var array<float> vol_total = array.new_float(100, 0.0)
var array<float> vol_up    = array.new_float(100, 0.0)
var array<float> vol_dn    = array.new_float(100, 0.0)

float poc_price     = na
float poc_hi        = na
float poc_lo        = na
float poc_delta_pct = na
int   poc_row       = 0

if not na(step_size) and prof_span > 0 and lb > 1
    for a = 0 to 2
        arr = a == 0 ? vol_total : a == 1 ? vol_up : vol_dn
        if arr.size() != rows
            arr.clear()
            for i = 0 to rows - 1
                arr.push(0.0)
        else
            for i = 0 to rows - 1
                arr.set(i, 0.0)

    for iBar = 0 to lb - 1
        float bar_vol = volume[iBar]
        if bar_vol <= 0
            continue
        float bar_lo = low[iBar]
        float bar_hi = high[iBar]
        bool  bar_up = close[iBar] >= open[iBar]
        int s_row = math.max(math.floor((bar_lo - prof_lo) / step_size), 0)
        int e_row = math.min(math.floor((bar_hi - prof_lo) / step_size), rows - 1)
        int span  = e_row - s_row + 1
        if span <= 0
            continue
        float per_row = bar_vol / span
        for k = 0 to span - 1
            int r = s_row + k
            if r >= 0 and r < rows
                vol_total.set(r, vol_total.get(r) + per_row)
                if bar_up
                    vol_up.set(r, vol_up.get(r) + per_row)
                else
                    vol_dn.set(r, vol_dn.get(r) + per_row)

    float max_vol = 0.0
    for r = 0 to rows - 1
        float v = vol_total.get(r)
        if v > max_vol
            max_vol := v
            poc_row := r

    poc_price := prof_lo + (poc_row + 0.5) * step_size
    poc_lo    := prof_lo + poc_row * step_size
    poc_hi    := prof_lo + (poc_row + 1) * step_size

    float poc_up_vol = vol_up.get(poc_row)
    float poc_dn_vol = vol_dn.get(poc_row)
    float poc_tot    = vol_total.get(poc_row)
    poc_delta_pct    := poc_tot > 0 ? ((poc_up_vol - poc_dn_vol) / poc_tot) * 100 : 0.0

bool poc_valid = not na(poc_hi) and not na(poc_lo)
bool poc_green = not na(poc_delta_pct) and poc_delta_pct > 0.0

var int bias = 0
if poc_valid
    if close > poc_hi
        bias := 1
    else if close < poc_lo
        bias := -1

float poc_width = poc_valid ? poc_hi - poc_lo : 0.0
float long_depth_level  = poc_valid ? poc_hi - poc_width * poc_entry_pct / 100.0 : na

bool price_in_poc  = poc_valid and high >= poc_lo and low <= poc_hi
bool depth_ok_long = price_in_poc and not na(long_depth_level) and low <= long_depth_level
bool bullish_candle = close > open

// ===== OPPOSING POC S/R =====
float prior_poc_l = poc_lo[prior_poc_bars]
float prior_poc_h = poc_hi[prior_poc_bars]
bool  prior_poc_ok = not na(prior_poc_h) and not na(prior_poc_l) and atr_ok
bool pocs_distinct = prior_poc_ok and poc_valid and math.abs(nz(poc_price) - (prior_poc_h + prior_poc_l) / 2) > atr_risk * 0.5
bool resist_blocks_long = pocs_distinct and prior_poc_l > close and (prior_poc_l - close) < opposing_atr_mult * atr_risk
bool opposing_ok_long  = not use_opposing_poc or not resist_blocks_long

// Cooldown + flat
var int last_trade_bar = -9999
bool cooled  = bar_index - last_trade_bar >= cooldown_bars
bool is_flat = strategy.position_size == 0 and (na(strategy.position_size[1]) or strategy.position_size[1] == 0)

// ===== LONG ENTRY SIGNAL =====
bool long_sig  = depth_ok_long and poc_green and pivot_ok_long and geometric_dip_ok and opposing_ok_long and slope_ok_long and bullish_candle and in_session and cooled and is_flat

// ===== ENTRIES =====
var float current_stop    = 0.0
var float entry_price     = 0.0
var float peak_profit_pts = 0.0
var bool  be_active       = false
var float peak_px         = na
var float atr_at_entry    = na

if long_sig
    float sl0 = na
    float lim = na
    if use_atr_risk and atr_ok
        float sl_atr = close - sl_atr_m * atr_risk
        sl0 := use_poc_stop and poc_valid ? math.max(poc_lo - 0.25, sl_atr) : sl_atr
        lim := tp_atr_m > 0 ? close + tp_atr_m * atr_risk : na
    else
        sl0 := use_poc_stop and poc_valid ? poc_lo - 0.25 : close - stop_pts
        lim := close + tp_pts
    entry_price     := close
    current_stop    := sl0
    peak_profit_pts := 0.0
    be_active       := false
    last_trade_bar  := bar_index
    peak_px         := high
    atr_at_entry    := atr_risk
    strategy.entry("Long", strategy.long)
    strategy.exit("XL", "Long", stop=current_stop, limit=lim)

// ===== DETECT CLOSE -> COOLDOWN =====
if strategy.position_size == 0 and strategy.position_size[1] != 0
    last_trade_bar := bar_index
    be_active      := false
    peak_px        := na
    atr_at_entry   := na

// ===== ATR RUNNER =====
if use_atr_risk and atr_ok and strategy.position_size > 0
    float avg = strategy.position_avg_price
    float a0  = nz(atr_at_entry, atr_risk)
    peak_px := strategy.position_size[1] == 0 ? high : math.max(nz(peak_px, high), high)
    if use_breakeven and not be_active and (close - avg) >= be_atr_mult * atr_risk
        be_active    := true
        current_stop := math.max(current_stop, avg + syminfo.mintick)
    bool arm = runner_activate_atr_mult <= 0 or (peak_px - avg) >= runner_activate_atr_mult * atr_risk
    if arm
        float tline = peak_px - runner_trail_atr_mult * atr_risk
        current_stop := math.max(current_stop, tline)
    float lim_tp = tp_atr_m > 0 ? avg + tp_atr_m * a0 : na
    strategy.exit("XL", "Long", stop=current_stop, limit=lim_tp)

// ===== LEGACY: $ breakeven =====
if not use_atr_risk and use_breakeven and strategy.position_size > 0 and not be_active
    if (close - entry_price) >= be_trigger_pts
        be_active    := true
        current_stop := entry_price + syminfo.mintick
        strategy.exit("XL", "Long", stop=current_stop, limit=entry_price + tp_pts)

if strategy.position_size == 0
    be_active := false

// ===== LEGACY: $ trailing =====
if not use_atr_risk and use_trail_stop and strategy.position_size > 0
    float avg = strategy.position_avg_price
    float profit_now = high - avg
    if profit_now > peak_profit_pts
        peak_profit_pts := profit_now
    if peak_profit_pts >= trail_min_dollars / pv
        float peak_d   = peak_profit_pts * pv * strategy.position_size
        int   steps    = math.floor(peak_d / trail_step_amt)
        float keep_pct = math.min(trail_pct + steps * trail_step_pct, 95.0)
        float new_stop = avg + peak_profit_pts * (keep_pct / 100.0)
        if new_stop > current_stop
            current_stop := new_stop
            strategy.exit("XL", "Long", stop=current_stop, limit=avg + tp_pts)
